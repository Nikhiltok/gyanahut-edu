# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=gyanahut
POSTGRES_USER=gyanahut
POSTGRES_PASSWORD=gyanahut
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3012

# Frontend URL (used to build links in emails, e.g. password reset)
FRONTEND_URL=http://localhost:3012

# Razorpay (Phase 7 — Mock Test Pricing & Payments)
# Leave blank in dev — payments.gateways falls back to a local test-mode order id.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OpenAI (AI question generation)
# Leave blank to disable — the "Generate with AI" action will fail with a clear error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend
# Backend is exposed on host port 8012, frontend dev server on 3012 (avoids clashing with other local services)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8012/api/v1
